###############################################################################
# Inventory & Distribution Platform — backend environment template
#
# Copy to `.env` and run `php artisan key:generate`.
#
# This file is the single source of boot configuration. The application boots
# and runs with ZERO optional configuration: every optional capability
# (AI reporting, SMS/WhatsApp, OTP, S3, custom LLM providers) is either absent
# or defaulted OFF below. Only a MySQL server (central DB) and a Redis server
# are required for full operation; nothing else must be set to start.
###############################################################################

APP_NAME="Inventory Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database — multi-tenant (stancl/tenancy, database-per-tenant)
#
# `central` is the default connection and holds all cross-tenant/platform data
# (tenants, domains, plans, plan_limits, subscriptions, Platform_Admin users).
# Each tenant's business data lives in its own MySQL database, created at
# provisioning time from the `tenant_template` connection. Isolation is
# physical — tenant-owned tables carry no tenant_id discriminator column.
###############################################################################
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_central
DB_USERNAME=root
DB_PASSWORD=

# Per-tenant database naming (prefix + tenant id + suffix).
TENANCY_DB_PREFIX=tenant
TENANCY_DB_SUFFIX=

###############################################################################
# Sessions / cache / queue — Redis for queue + cache
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue + cache both run on Redis (minimal, optional-friendly).
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

###############################################################################
# Redis — queue + cache
#
# predis is a pure-PHP client and requires no PHP extension, so the app boots
# without the phpredis extension installed.
###############################################################################
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

###############################################################################
# Auth (Sanctum)
###############################################################################
# Stateful domains for Sanctum SPA auth (optional; token auth needs no config).
# SANCTUM_STATEFUL_DOMAINS=localhost

###############################################################################
# Mail — defaults to the log driver so no SMTP config is needed to boot.
# Per-tenant outbound sender identity overrides these at runtime (white-label).
###############################################################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# OPTIONAL FEATURES — all OFF by default. The app builds and runs without any
# of these set. Enabling them is additive and never required to boot.
###############################################################################

# --- AI reporting (gated by env master switch AND per-tenant feature flag) ---
AI_REPORTS_ENABLED=false
# LLM_PROVIDER: ollama | openai_compatible | none  (none => NullLlmClient no-op)
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=30

# --- Optional object storage (S3) — unused unless FILESYSTEM_DISK=s3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Daily database backups (R36.4) — OFF by default so local/CI never dump ---
# When enabled, the scheduled `db:backup` command dumps the central database
# plus every tenant database daily via the native mysqldump client. Set
# BACKUP_ENABLED=true in production. The scheduler itself is always registered;
# the command no-ops while disabled.
BACKUP_ENABLED=false
# BACKUP_DESTINATION=storage/app/backups   # resolved under storage_path() by default
# BACKUP_RETENTION_DAYS=7                   # prune dated backups older than N days (0 = keep all)
# BACKUP_MYSQLDUMP_BINARY=mysqldump         # absolute path if mysqldump is not on PATH

VITE_APP_NAME="${APP_NAME}"
