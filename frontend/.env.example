# ─── Frontend environment (white-label theme loader) ────────────────────────
# Copy to `.env.local` for local dev. Every value has a safe default so the app
# boots with zero config (R37.4).

# Base URL of the Laravel API. Server-side fetches target this; client-side
# same-origin requests ignore it. Defaults to http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# DEV ONLY: pin the tenant resolution host when running on localhost (where
# there is no tenant subdomain). The backend resolves the tenant from this host
# via stancl/tenancy. Example: a tenant provisioned with subdomain "acme".
# Leave empty in production — the real request host is used instead.
# NEXT_PUBLIC_TENANT_HOST=acme.localhost
